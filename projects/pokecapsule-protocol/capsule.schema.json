{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pokecapsule.local/schema/capsule-1.0.json",
  "title": "PokeCapsule Capsule",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "id",
    "createdAt",
    "updatedAt",
    "revision",
    "favorite",
    "tags"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "favorite": {
      "type": "boolean"
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50
      },
      "maxItems": 100
    },
    "language": {
      "type": "string",
      "default": "zh"
    },
    "contentHash": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "finalTextFile": {
      "type": ["string", "null"],
      "enum": ["final.md", null]
    }
  }
}
